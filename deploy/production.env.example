# Copy selected values to the private VM environment; never commit the filled file.
DEBUG=False
SECRET_KEY=REPLACE_ME
ALLOWED_HOSTS=carbonique.example.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://carbonique.example.org
TRUST_PROXY_HEADERS=True
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128
PUBLIC_FIELDNOTES_ENABLED=True
MEDIA_ROOT=/srv/carbonique-media
DATABASE_URL=postgresql://carbonique:replace-with-a-strong-url-encoded-password@localhost:5432/carbonique
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-your-smtp-account
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
DEFAULT_FROM_EMAIL=carbonique@example.org
MONITOR_STATIONS_FILE=/etc/carbonique/monitor-stations.json
