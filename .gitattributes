# Keep source text portable across Windows and Linux.
* text=auto eol=lf

# Preserve the bundled report and reference snapshots.
public/fieldnotes/index.html binary linguist-generated=true
seed/fieldnotes.json text eol=lf linguist-generated=true
seed/ecoflux_inventory_export/** -text linguist-generated=true
seed/badm/schema.json text eol=lf linguist-generated=true
static/hub/vendor/** -text linguist-vendored=true

# Keep original INI bytes and their existing whitespace unchanged.
seed/processing_files/** -text -whitespace
seed/processing_files/catalogue.json text eol=lf

# Store documents without text or line-ending conversion.
*.pdf binary
