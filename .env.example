# Local development defaults. Generate a new secret and use DEBUG=False in production.
DEBUG=True
SECRET_KEY=development-only-change-before-deployment-carbonique
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
# Empty means local SQLite. PostgreSQL example:
# DATABASE_URL=postgresql://carbonique:your-password@localhost:5432/carbonique
DATABASE_URL=
# Keep the existing EcoFlux DB_ENGINE/DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT
# instead of DATABASE_URL when upgrading its MariaDB/MySQL database.
# Install mysqlclient separately for django.db.backends.mysql.
MEDIA_ROOT=
PUBLIC_FIELDNOTES_ENABLED=True
# Optional override: absolute path to a live-mounted replacement index.html
# FIELDNOTES_HTML=/srv/carbonique/public/fieldnotes/index.html
PUBLIC_REFERENCE_ENABLED=False
TRUST_PROXY_HEADERS=False
# Automatic HTTPS redirect defaults to True when DEBUG=False.
# SECURE_SSL_REDIRECT=True
MAX_UPLOAD_BYTES=26214400
MAX_SITE_MEDIA_BYTES=104857600
# Private, untracked JSON on the VM. Never put tower hosts or credentials in Git.
MONITOR_STATIONS_FILE=
MONITOR_TIMEOUT=6
MONITOR_MIN_INTERVAL=30
MONITOR_STALE_SECONDS=300
# Directory outside checkout/image containing credential-bearing source PDFs.
PRIVATE_PROTOCOLS_DIR=
# Real SMTP is needed for password reset emails in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=carbonique@localhost
